# Copy this file to terraform.tfvars and set your custom AMI ID.
aws_region                    = "ap-southeast-1"
service_ami_id                = "ami-REPLACE_WITH_YOUR_CUSTOM_AMI_ID"
service_instance_type         = "t3.micro"
service_port                  = 9090
customer_profile_ingress_cidr = "0.0.0.0/0"

vpc_cidrs = {
  customer_profile = "10.0.0.0/16"
  account          = "10.1.0.0/16"
  statement        = "10.2.0.0/16"
}

subnet_cidrs = {
  customer_profile = "10.0.1.0/24"
  account          = "10.1.1.0/24"
  statement        = "10.2.1.0/24"
}
